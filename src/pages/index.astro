---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { publishedTopics, safeJson } from '../lib/content';
import { categories } from '../data/taxonomy.mjs';
const topics = await publishedTopics();
const tags = [...new Set(topics.flatMap((t) => t.data.tags))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="专题索引">
  <div class="page-heading">
    <p class="eyebrow">
      THE KNOWLEDGE BASE <span>/ 01</span>
    </p>
    <div class="heading-row">
      <h1>
        专题索引<span class="heading-dot">.</span>
      </h1>
      <a class="text-link" href={`${base}/interview/`}>
        开始一次随机面试 ↗
      </a>
    </div>
    <p class="intro">从 C++ 语言细节，到交易系统的每一微秒。</p>
  </div>
  <section class="library" aria-label="专题搜索与筛选">
    <form id="search-form" role="search">
      <div class="search-box">
        <span aria-hidden="true">⌕</span>
        <input
          type="search"
          id="search"
          name="q"
          aria-label="全文搜索"
          placeholder="搜索概念、代码、问题… 试试 happens-before"
          autocomplete="off"
        />
        <kbd>/</kbd>
      </div>
      <div class="filters">
        <label>
          分类
          <select id="category" name="category">
            <option value="">全部领域</option>
            {categories.map((c) => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </label>
        <label>
          难度
          <select id="level" name="level">
            <option value="">全部难度</option>
            <option>L1</option>
            <option>L2</option>
            <option>L3</option>
          </select>
        </label>
        <label>
          标签
          <select id="tag" name="tag">
            <option value="">全部标签</option>
            {tags.map((tag) => (
              <option>{tag}</option>
            ))}
          </select>
        </label>
        <label>
          学习状态
          <select id="status" name="status">
            <option value="">全部专题</option>
            <option value="unread">未读</option>
            <option value="read">已读</option>
            <option value="saved">已收藏</option>
          </select>
        </label>
        <button type="reset" class="reset-button">
          清除筛选
        </button>
      </div>
    </form>
    <div class="list-meta">
      <span id="result-count" role="status">
        {topics.length} 篇已发布专题
      </span>
      <span>机制 → 代码 → 面试</span>
    </div>
    <div id="topic-list">
      {topics.map(({ data }, index) => (
        <article class="topic-row" data-topic-row={data.id}>
          <span class="row-number">{String(index + 1).padStart(2, '0')}</span>
          <div class="row-content">
            <div class="topic-kicker">
              <span>{categories.find((c) => c.id === data.category)?.name}</span>
              <span class="level-badge">
                {data.difficulty}{' '}
                {data.difficulty === 'L1' ? '基础' : data.difficulty === 'L2' ? '深入' : '工程进阶'}
              </span>
            </div>
            <h2>
              <a href={`${base}/topics/${data.id}/`}>{data.title}</a>
            </h2>
            <p class="topic-description">{data.description}</p>
            <p class="search-excerpt" hidden></p>
            <div class="row-bottom">
              <div class="tag-list">
                {data.tags.map((tag) => (
                  <a href={`${base}/?tag=${tag}`}>#{tag}</a>
                ))}
              </div>
              <span class="row-time">
                {data.estimatedMinutes} 分钟 · {data.questions.length} 道面试题
              </span>
            </div>
          </div>
          <div class="row-actions">
            <button type="button" data-progress="saved" data-topic={data.id} aria-pressed="false">
              ☆ 收藏
            </button>
            <button type="button" data-progress="read" data-topic={data.id} aria-pressed="false">
              标记已读
            </button>
          </div>
        </article>
      ))}
    </div>
    <div id="empty-state" class="empty-state" hidden>
      <h2>没有匹配的专题</h2>
      <p>试试更短的关键词，或清除筛选。尚未发布的领域可以在知识地图查看计划。</p>
      <a href={`${base}/roadmap/`}>查看知识地图 ↗</a>
    </div>
  </section>
  <div class="editorial-note">
    <span class="small-label">FIRST EDITION</span>
    <p>
      {topics.length} 篇已发布专题，{topics.reduce((n, t) => n + t.data.questions.length, 0)}{' '}
      道分层练习。
      <br />
      <span class="muted">专题包含原理讲解、可运行示例和参考答案。</span>
    </p>
    <a href={`${base}/roadmap/`}>查看后续计划 ↗</a>
  </div>
  <script
    type="application/json"
    id="search-data"
    set:html={safeJson(
      topics.map((t) => ({
        ...t.data,
        body: `${t.body || ''}\n${readFileSync(t.data.demo.file, 'utf8')}`,
      })),
    )}
  ></script>
  <script src="../scripts/search.ts"></script>
</Layout>
